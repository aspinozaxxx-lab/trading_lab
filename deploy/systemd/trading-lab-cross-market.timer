[Unit]
Description=Trading Lab cross-market snapshots every ten minutes

[Timer]
OnCalendar=Mon..Fri *-*-* 10..17:09/10:00
OnCalendar=Mon..Fri *-*-* 18:09,19,29,39:00
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=trading-lab-collector@cross-market.service

[Install]
WantedBy=timers.target
